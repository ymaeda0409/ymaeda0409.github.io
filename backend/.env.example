APP_NAME="Malawi Bento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (recommended). MySQL 8 also works: DB_CONNECTION=mysql, DB_PORT=3306
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=malawi_bento
DB_USERNAME=bento
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# S3-compatible storage for product images: FILESYSTEM_DISK=s3 + AWS_* (+ AWS_ENDPOINT for MinIO/Wasabi)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# --- Malawi Bento platform -------------------------------------------------
# Default / fallback locale (must exist in the `languages` table)
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=MWK
PHONE_DEFAULT_COUNTRY_CODE=265

# OTP. Test mode uses a fixed code and is ignored when APP_ENV=production.
OTP_TEST_MODE=true
OTP_TEST_CODE=123456
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMS: log (development). Production drivers are added behind App\Services\Contracts\SmsGateway.
SMS_DRIVER=log
SMS_SENDER_ID=MWBENTO
SMS_MAX_SEGMENTS=2

# Payment gateway (PHASE 5): fake | paychangu
PAYMENT_GATEWAY=fake
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=

# Google Maps (apps use their own restricted keys; this one is for server-side use)
GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (PHASE 5)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

GEO_MAX_ZONE_RADIUS_KM=50
